{
  "name": "backend",
  "version": "0.0.1",
  "description": "NestJS backend project",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "start:dev": "ts-node src/main.ts",
    "start:prod": "node dist/main",
    "create-user": "ts-node scripts/create-user.ts",
    "seed": "ts-node --transpile-only scripts/seed.ts",
    "typeorm": "ts-node --transpile-only ../../node_modules/typeorm/cli",
    "migration:generate": "ts-node --transpile-only ../../node_modules/typeorm/cli migration:generate -d src/data-source.ts",
    "migration:run": "ts-node --transpile-only ../../node_modules/typeorm/cli migration:run -d src/data-source.ts",
    "migration:revert": "ts-node --transpile-only ../../node_modules/typeorm/cli migration:revert -d src/data-source.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "coverageDirectory": "../coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.1",
    "adm-zip": "^0.6.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.6.1",
    "mysql2": "^3.23.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sql.js": "^1.10.0",
    "typeorm": "^0.3.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
